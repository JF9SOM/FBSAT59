{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-docs.sh\"",
            "timeout": 15,
            "statusMessage": "Loading area docs"
          }
        ]
      }
    ]
  }
}
