#: src/ui/main_window.py:8705
msgid ""
"<table border='0' cellspacing='4'><tr><td><b>Space Stations</b> (ISS, CSS…)</"
"td><td>every <b>1 hour</b></td></tr><tr><td><b>Amateur Satellites</b></"
"td><td>every <b>2 hours</b></td></tr><tr><td><b>CubeSats</b></td><td>every "
"<b>4 hours</b></td></tr><tr><td><b>Weather Satellites</b></td><td>every <b>6 "
"hours</b></td></tr><tr><td><b>Earth Observation / Science</b></td><td>every "
"<b>12 hours</b></td></tr><tr><td><b>METEOR/HRPT satellites dropped from "
